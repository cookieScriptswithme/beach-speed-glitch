--[[
    Portable Beach Speed CNP
    - Capture tool name (same method as gravity coils)
    - Saves the chosen gear name so it persists after leaving the game
    - Speed only runs while that exact tool is equipped
    - Small UI + minimize to circle
    - Dragging the circle no longer opens the UI
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local CONFIG_FILE = "beach_speedcnp.json"
local hasFS = (type(writefile) == "function")
          and (type(readfile)  == "function")
          and (type(isfile)    == "function")

local chosenBeach = nil
local captureMode = false

local uiEnabled = false
local speedActive = false
local isMinimized = false

local offsetAmount = Vector3.new(0, 0, 5.2)
local weightMass = 20.6
local weightName = "CoMWeight_Object"
local lastJumpBoostTime = 0
local currentRotSpeed = 0
local lastLook = camera.CFrame.LookVector
local connections = {}

local function saveConfig()
    if not hasFS then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode({
            beachGear = chosenBeach,
            uiEnabled = uiEnabled
        }))
    end)
end

local function loadConfig()
    if not hasFS then return end
    pcall(function()
        if isfile(CONFIG_FILE) then
            local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
            if type(data) == "table" then
                if type(data.beachGear) == "string" and data.beachGear ~= "" then
                    chosenBeach = data.beachGear
                end
                if type(data.uiEnabled) == "boolean" then
                    uiEnabled = data.uiEnabled
                end
            end
        end
    end)
end

loadConfig()

local function clearConnections()
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
end

local function applyWeight(character)
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 3)
    if not root then return end
    local existing = character:FindFirstChild(weightName)
    if existing then existing:Destroy() end

    local weight = Instance.new("Part")
    weight.Name = weightName
    weight.Size = Vector3.new(1, 1, 1)
    weight.Transparency = 1
    weight.CanCollide = false
    weight.CanQuery = false
    weight.Massless = false
    weight.CustomPhysicalProperties = PhysicalProperties.new(weightMass, 0.3, 0.5)
    weight.Parent = character

    local weld = Instance.new("Weld")
    weld.Part0 = root
    weld.Part1 = weight
    weld.C0 = CFrame.new(offsetAmount)
    weld.Parent = weight
end

local function removeWeight(character)
    if character then
        local existing = character:FindFirstChild(weightName)
        if existing then existing:Destroy() end
    end
end

local function isReallyInWater(humanoid)
    if not humanoid then return false end
    if humanoid:GetState() == Enum.HumanoidStateType.Swimming then return true end
    if humanoid.FloorMaterial == Enum.Material.Water then return true end
    return false
end

local function tryWaterJumpBoost()
    if not speedActive then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    if not isReallyInWater(hum) then return end

    local now = tick()
    if now - lastJumpBoostTime < 0.5 then return end
    lastJumpBoostTime = now

    local baseBoost = 29
    local flickBonus = math.clamp(currentRotSpeed * 1.35, 0, 16)
    local totalBoost = baseBoost + flickBonus
    local vel = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(vel.Y, 0) + totalBoost, vel.Z)
end

local function startGlitch()
    if speedActive then return end
    speedActive = true
    local char = player.Character
    if char then applyWeight(char) end

    connections[#connections+1] = RunService.RenderStepped:Connect(function(dt)
        if not speedActive then return end
        local cam = Workspace.CurrentCamera
        local currentLook = cam.CFrame.LookVector
        currentRotSpeed = (currentLook - lastLook).Magnitude / math.max(dt, 0.001)
        lastLook = currentLook

        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0.1 then
            local isMovingBack = moveDir:Dot(currentLook) < -0.35
            if isMovingBack and currentRotSpeed > 8 then
                local boostPower = math.clamp(currentRotSpeed * 1.15, 0, 52)
                root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + (moveDir.Unit * boostPower * dt * 42)
            end
        end
    end)

    connections[#connections+1] = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe or not speedActive then return end
        if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then
            tryWaterJumpBoost()
        end
    end)

    if player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            connections[#connections+1] = hum.StateChanged:Connect(function(old, new)
                if old == Enum.HumanoidStateType.Swimming and
                   (new == Enum.HumanoidStateType.Jumping or new == Enum.HumanoidStateType.Freefall) then
                    tryWaterJumpBoost()
                end
            end)
        end
    end
end

local function stopGlitch()
    if not speedActive then return end
    speedActive = false
    clearConnections()
    removeWeight(player.Character)
end

local function isBeachEquipped()
    if not chosenBeach or not player.Character then return false end
    for _, t in ipairs(player.Character:GetChildren()) do
        if t:IsA("Tool") and t.Name == chosenBeach then
            return true
        end
    end
    return false
end

local function refreshState()
    if uiEnabled and isBeachEquipped() then
        startGlitch()
    else
        stopGlitch()
    end
end

-- ========== UI ==========
local mainFrame, miniCircle, statusLabel, toggleBtn, setGearBtn, minBtn

local function updateUI()
    if not statusLabel then return end

    if not chosenBeach then
        statusLabel.Text = "No beach gear set"
        statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        setGearBtn.Text = "Set Beach Gear"
    else
        if isBeachEquipped() then
            if speedActive then
                statusLabel.Text = chosenBeach .. "  |  ACTIVE"
                statusLabel.TextColor3 = Color3.fromRGB(70, 220, 110)
            else
                statusLabel.Text = chosenBeach .. "  |  equipped"
                statusLabel.TextColor3 = Color3.fromRGB(220, 180, 70)
            end
        else
            statusLabel.Text = chosenBeach .. "  |  not equipped"
            statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
        setGearBtn.Text = "Beach: " .. chosenBeach
    end

    if uiEnabled then
        toggleBtn.Text = "ON"
        toggleBtn.BackgroundColor3 = speedActive and Color3.fromRGB(40, 150, 65) or Color3.fromRGB(120, 80, 40)
    else
        toggleBtn.Text = "OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
    end

    if miniCircle then
        if speedActive then
            miniCircle.BackgroundColor3 = Color3.fromRGB(40, 150, 65)
        elseif uiEnabled then
            miniCircle.BackgroundColor3 = Color3.fromRGB(120, 80, 40)
        else
            miniCircle.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        end
    end
end

local function setMinimized(state)
    isMinimized = state
    if state then
        mainFrame.Visible = false
        miniCircle.Visible = true
        miniCircle.Position = mainFrame.Position
    else
        miniCircle.Visible = false
        mainFrame.Visible = true
        mainFrame.Position = miniCircle.Position
    end
end

local function createUI()
    local old = player.PlayerGui:FindFirstChild("SpeedCNP_UI")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = "SpeedCNP_UI"
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = player:WaitForChild("PlayerGui")

    -- MAIN FRAME (smaller)
    mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.fromOffset(210, 118)
    mainFrame.Position = UDim2.fromScale(0.5, 0.12)
    mainFrame.AnchorPoint = Vector2.new(0.5, 0)
    mainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    mainFrame.BorderSizePixel = 0
    mainFrame.Active = true
    mainFrame.Parent = sg

    Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 9)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 55, 55)
    stroke.Thickness = 1.3
    stroke.Parent = mainFrame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -28, 0, 24)
    title.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    title.BorderSizePixel = 0
    title.Font = Enum.Font.GothamBold
    title.TextSize = 12
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Text = "Speed CNP"
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = mainFrame

    local titlePad = Instance.new("UIPadding")
    titlePad.PaddingLeft = UDim.new(0, 8)
    titlePad.Parent = title

    Instance.new("UICorner", title).CornerRadius = UDim.new(0, 9)

    local titleFix = Instance.new("Frame")
    titleFix.Size = UDim2.new(1, 0, 0, 10)
    titleFix.Position = UDim2.new(0, 0, 1, -10)
    titleFix.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    titleFix.BorderSizePixel = 0
    titleFix.Parent = title

    -- minimize button (−)
    minBtn = Instance.new("TextButton")
    minBtn.Size = UDim2.fromOffset(22, 20)
    minBtn.Position = UDim2.new(1, -24, 0, 2)
    minBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    minBtn.BorderSizePixel = 0
    minBtn.Font = Enum.Font.GothamBold
    minBtn.TextSize = 16
    minBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    minBtn.Text = "−"
    minBtn.AutoButtonColor = true
    minBtn.Parent = mainFrame
    Instance.new("UICorner", minBtn).CornerRadius = UDim.new(0, 5)

    minBtn.MouseButton1Click:Connect(function()
        setMinimized(true)
    end)

    statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, -12, 0, 16)
    statusLabel.Position = UDim2.fromOffset(6, 28)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.TextSize = 11
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
    statusLabel.Text = "No beach gear set"
    statusLabel.Parent = mainFrame

    setGearBtn = Instance.new("TextButton")
    setGearBtn.Size = UDim2.new(1, -12, 0, 24)
    setGearBtn.Position = UDim2.fromOffset(6, 48)
    setGearBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    setGearBtn.BorderSizePixel = 0
    setGearBtn.Font = Enum.Font.GothamMedium
    setGearBtn.TextSize = 11
    setGearBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
    setGearBtn.Text = "Set Beach Gear"
    setGearBtn.AutoButtonColor = true
    setGearBtn.Parent = mainFrame
    Instance.new("UICorner", setGearBtn).CornerRadius = UDim.new(0, 6)

    toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(1, -12, 0, 28)
    toggleBtn.Position = UDim2.fromOffset(6, 78)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextSize = 13
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.Text = "OFF"
    toggleBtn.AutoButtonColor = false
    toggleBtn.Parent = mainFrame
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 6)

    setGearBtn.MouseButton1Click:Connect(function()
        captureMode = true
        setGearBtn.Text = "Equip beach gear..."
        setGearBtn.BackgroundColor3 = Color3.fromRGB(180, 120, 40)
    end)

    toggleBtn.MouseButton1Click:Connect(function()
        uiEnabled = not uiEnabled
        saveConfig()
        refreshState()
        updateUI()
    end)

    -- MINI CIRCLE
    miniCircle = Instance.new("TextButton")
    miniCircle.Size = UDim2.fromOffset(36, 36)
    miniCircle.Position = mainFrame.Position
    miniCircle.AnchorPoint = Vector2.new(0.5, 0)
    miniCircle.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    miniCircle.BorderSizePixel = 0
    miniCircle.Text = ""
    miniCircle.AutoButtonColor = false
    miniCircle.Visible = false
    miniCircle.Parent = sg

    Instance.new("UICorner", miniCircle).CornerRadius = UDim.new(1, 0)

    local miniStroke = Instance.new("UIStroke")
    miniStroke.Color = Color3.fromRGB(255, 55, 55)
    miniStroke.Thickness = 1.5
    miniStroke.Parent = miniCircle

    local miniIcon = Instance.new("TextLabel")
    miniIcon.Size = UDim2.fromScale(1, 1)
    miniIcon.BackgroundTransparency = 1
    miniIcon.Font = Enum.Font.GothamBold
    miniIcon.TextSize = 14
    miniIcon.TextColor3 = Color3.fromRGB(255, 255, 255)
    miniIcon.Text = "S"
    miniIcon.Parent = miniCircle

    -- drag vs click logic for the circle
    local mDragging = false
    local mDragStart = nil
    local mStartPos = nil
    local hasDragged = false
    local DRAG_THRESHOLD = 6 -- pixels

    miniCircle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            mDragging = true
            hasDragged = false
            mDragStart = input.Position
            mStartPos = miniCircle.Position
        end
    end)

    miniCircle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if mDragging then
                mDragging = false
                -- only open if we barely moved
                if not hasDragged then
                    setMinimized(false)
                end
            end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if mDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - mDragStart
            if delta.Magnitude > DRAG_THRESHOLD then
                hasDragged = true
            end
            miniCircle.Position = UDim2.new(mStartPos.X.Scale, mStartPos.X.Offset + delta.X, mStartPos.Y.Scale, mStartPos.Y.Offset + delta.Y)
        end
    end)

    -- drag for main frame
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    title.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    updateUI()
end

createUI()

local function onCharacterAdded(character)
    character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and captureMode then
            chosenBeach = child.Name
            captureMode = false
            setGearBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            saveConfig()
            print("[Speed CNP] Beach gear saved:", chosenBeach)
            refreshState()
            updateUI()
        end
    end)

    character.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") and child.Name == chosenBeach then
            refreshState()
            updateUI()
        end
    end)

    task.defer(function()
        refreshState()
        updateUI()
    end)
end

if player.Character then
    onCharacterAdded(player.Character)
end
player.CharacterAdded:Connect(function(char)
    stopGlitch()
    onCharacterAdded(char)
end)

RunService.Heartbeat:Connect(function()
    local was = speedActive
    refreshState()
    if was ~= speedActive then
        updateUI()
    end
end)

print("[Speed CNP] Loaded — drag circle no longer opens UI")
